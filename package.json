{
  "name": "@ch4acko3/dsh-turn-fold",
  "version": "0.3.0",
  "description": "Codex-style turn folding for the DSH WebUI conversation, implemented as a dsh-harmony provider.",
  "main": "./index.cjs",
  "files": [
    "README.md",
    "harmony.patch.yml",
    "index.cjs",
    "inline-source.cjs",
    "locales.cjs",
    "locales/*.json",
    "settings.cjs",
    "patch.cjs"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ch4acko3/dsh-turn-fold.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./harmony.patch.yml"
    },
    "harmony": {
      "patches": ["./patch.cjs"]
    },
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "en": "Turn Fold",
        "zh-CN": "Turn Fold"
      },
      "summary": {
        "en": "Collapse each completed turn's agent activity into a summary bar; keep the final answer visible.",
        "zh-CN": "将每个已完成 turn 的 Agent activity 折叠成摘要栏，最终答复保持可见。"
      },
      "category": "ui"
    }
  },
  "scripts": {
    "test": "node test/run.cjs",
    "check": "node test/run.cjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "0.1.0-rc.8",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.8",
    "@phenomnomnominal/tsquery": "^6.2.0",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "^6.0.3"
  }
}
